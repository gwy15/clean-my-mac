{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clean My Mac",
  "version": "0.1.0",
  "identifier": "com.gwy15.clean-my-mac",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clean My Mac",
        "width": 920,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "扫描磁盘占用，按需清理缓存。",
    "icon": ["icons/icon.icns", "icons/128x128.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
